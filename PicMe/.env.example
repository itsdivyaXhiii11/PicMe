# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# ---------------- Person A: Supabase (A1) ----------------
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY      # server-side secret, never in git/frontend
# Settings -> Database -> Connection string -> URI (contains your db password)
# Use the POOLER (port 6543) for the event: it survives many students at once.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-XX.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------- Person A: matching / sessions (A5, A6) ----------------
THRESHOLD=0.45            # cosine similarity; higher = stricter, lower = more matches
SESSION_SECONDS=3600      # how long a student's scan stays valid

# ---------------- Person A: rate limit (A7) ----------------
MAX_TRIES=300             # selfie attempts per IP per WINDOW seconds (campus shares one IP)
WINDOW=600                # window in seconds (10 minutes)
PROXY_HOPS=0              # set to 1+ when behind a proxy: read real client IP from X-Forwarded-For

# ---------------- Person A: admin API (A8) ----------------
ADMIN_PASSWORD=change-me  # checked on EVERY /admin/* endpoint - change it!

# ---------------- Person A: extra knobs ----------------
STORAGE_BUCKET=thumbs     # Supabase Storage bucket for the 600px thumbnails
EXPORT_LINK_TTL=86400     # how long an admin download link stays valid (24h)
PUBLIC_URL=               # e.g. https://picme.your-domain.com (only used to build links)
POOL_SIZE=5               # Postgres connections the server keeps open

# ---------------- existing settings (read by common.py) ----------------
DRIVE_FOLDER_ID=
SERVICE_ACCOUNT_FILE=service_account.json
LOCAL_DIR=photos
ALLOW_SELFIE_UPLOAD=0

# ---------------- Person A: extra tuning knobs ----------------
SESSION_SECONDS=3600       # how long a student's scan stays valid
POOL_SIZE=5                # Postgres connections kept open (db.py)
STORAGE_BUCKET=thumbs      # Supabase Storage bucket holding thumbnails
EXPORT_LINK_TTL=86400      # how long a regenerated admin link stays valid (24h)
PUBLIC_URL=                # e.g. https://picme.example.com - only used to build admin links

# ---------------- Person B adds their lines here (zip size, drive concurrency) ----------------
